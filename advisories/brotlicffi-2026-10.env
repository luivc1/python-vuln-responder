# =====================================================================
#  Advisory file. One package per file; the scanner loads every *.env in
#  advisories/ (or the ones you pass with --advisory).
#  Version ranges: comma = AND, | = OR.
# =====================================================================

ADVISORY_ID="brotlicffi-2026-10"
ADVISORY_NAME="HTTP2Shell: Brotli decoder out-of-bounds write in brotlicffi (CVE-2026-111497)"
PACKAGE="brotlicffi"
IMPORT_NAMES="brotlicffi"
SEVERITY="high (memory corruption; code execution shown in a lab against Node.js)"
PUBLISHED="2026-10-22"

SUMMARY="brotlicffi is the CFFI binding to Google's Brotli C decoder (used instead of Brotli on PyPy and by some installs of urllib3, httpx and aiohttp). It bundles the decoder affected by HTTP2Shell (CVE-2026-111497, Brotli 1.0.3 to 1.2.0). Reached by decompressing attacker-controlled data, including responses that HTTP clients decode automatically. As of 2026-10-24: no confirmed in-the-wild exploitation, not in CISA KEV."

AFFECTED="<1.2.1.0"
FIXED="1.2.1.0"
# brotlicffi 1.2.1.0 requires Python >= 3.8 (PyPI metadata)
FIX_MIN_PYTHON="3.8"
BACKPORTS=""
BACKPORT_CVES="CVE-2026-111497"

RISK_PACKAGES="urllib3:urllib3 (requests, pip, botocore) decodes Brotli responses automatically when brotlicffi is installed|aiohttp:aiohttp decodes Brotli responses and request bodies|httpx:httpx decodes Brotli responses when brotlicffi is installed"
PULLED_BY=""

CODE_HINTS="brotlicffi\.decompress\(|brotlicffi\.Decompressor\( => direct Brotli decompression (untrusted input reaches the decoder)"

MITIGATIONS="Until upgraded: uninstall brotlicffi where Brotli support is optional; block Content-Encoding: br request bodies at the proxy for aiohttp servers; isolate services that fetch untrusted URLs. Do not just strip br from Accept-Encoding."

IDS="CVE-2026-111497 (HTTP2Shell)"

RELOCK="uv lock --upgrade-package brotlicffi | poetry update brotlicffi | pip-compile --upgrade-package brotlicffi | pdm update brotlicffi"

SOURCES="https://pypi.org/project/brotlicffi/1.2.1.0/ | https://github.com/google/brotli/releases | https://strobes.co/blog/http2shell-brotli-rce-cve-2026-111497/"
LAST_VERIFIED="2026-10-24"
