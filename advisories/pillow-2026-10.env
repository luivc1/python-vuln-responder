# =====================================================================
#  Advisory file. One package per file; the scanner loads every *.env in
#  advisories/ (or the ones you pass with --advisory). To cover a new PyPI
#  advisory, copy this file and update it from the official sources.
#
#  Version ranges: comma = AND, | = OR.  Example: ">=2.6.0,<13.0.0"
# =====================================================================

ADVISORY_ID="pillow-2026-10"
ADVISORY_NAME="Pillow 13.0.0 security release (October 2026)"
PACKAGE="pillow"
IMPORT_NAMES="PIL"
SEVERITY="critical"
PUBLISHED="2026-10-16"

SUMMARY="Pillow 13.0.0 fixes about 40 security issues, two rated critical by the maintainers: reuse of stale image storage after mode changes, and JPEG decoder buffer overflows. Others include EPS filename injection into Ghostscript (command execution), buffer overflows in lossless-JPEG thumbnails and in-memory compressed TIFF saves (public proof of concept), and many crash and denial-of-service bugs. Triggered by opening or saving crafted images. No known exploitation at publication."

# Every version before the fix is affected (the article cites 2.6.0 onward for EPS).
AFFECTED=">=0,<13.0.0"
FIXED="13.0.0"

# The fixed release needs Python >= 3.11. No 12.x backport was published, so
# Python 3.10 environments cannot get the fix without upgrading Python.
FIX_MIN_PYTHON="3.11"
BACKPORTS=""

# Conditions that make specific flaws reachable (shown as risk context)
RISK_BINARIES="gs:Ghostscript is installed, which makes the EPS command-injection path reachable"
RISK_PACKAGES="olefile:olefile is installed, which enables the FlashPix (FPX) decoding path reported to run commands from Image.open()"

# Code patterns that raise exposure (shown as hints when --project scans code)
# Format: regex => label ;; regex => label
CODE_HINTS="\.thumbnail\(|\.draft\( => thumbnail()/draft() on untrusted JPEGs (lossless-JPEG overflow) ;; EpsImagePlugin|\.eps['\"] => EPS handling (Ghostscript command injection) ;; BytesIO[\s\S]{0,300}TIFF|TIFF[\s\S]{0,300}BytesIO => saving TIFF to memory (in-memory TIFF overflow)"

MITIGATIONS="Until upgraded: remove Ghostscript (gs) from hosts that process untrusted images; never pass user-controlled filenames to Image.open(); avoid draft()/thumbnail() on untrusted JPEGs (call load() first or pass reducing_gap=None); restrict formats with Image.open(fp, formats=[...]); treat saving user images as TIFF to io.BytesIO as sensitive."

IDS="CVE-2026-96639 (critical, stale image storage after mode change) | GHSA-5x8w-8jj5-q52h, GHSA-8g5g-8vmr-9782 (critical, JPEG decoder overflow) | GHSA-w889-685w-c8fh (EPS filename injection into Ghostscript) | CVE-2026-96644 | CVE-2026-96637 | CVE-2026-96643 | CVE-2026-96778 | CVE-2026-96640 | CVE-2026-96636 | CVE-2026-96642 | CVE-2026-96638 | CVE-2026-96641 | press-reported IDs: CVE-2026-112900 (EPS), CVE-2026-112403 (lossless JPEG thumbnail), CVE-2026-112393 (TIFF to memory, public PoC)"

RELOCK="uv lock --upgrade-package pillow | poetry update pillow | pip-compile --upgrade-package pillow | pdm update pillow"

SOURCES="https://pillow.readthedocs.io/en/stable/releasenotes/13.0.0.html | https://pypi.org/project/pillow/13.0.0/ | https://thehackernews.com/2026/10/critical-flaw-in-pythons-popular-pillow.html"
LAST_VERIFIED="2026-10-23"
