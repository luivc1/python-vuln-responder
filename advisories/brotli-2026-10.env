# =====================================================================
#  Advisory file. One package per file; the scanner loads every *.env in
#  advisories/ (or the ones you pass with --advisory).
#  Version ranges: comma = AND, | = OR.
# =====================================================================

ADVISORY_ID="brotli-2026-10"
ADVISORY_NAME="HTTP2Shell: Brotli decoder out-of-bounds write (CVE-2026-111497)"
PACKAGE="Brotli"
IMPORT_NAMES="brotli"
SEVERITY="high (memory corruption; code execution shown in a lab against Node.js)"
PUBLISHED="2026-10-22"

SUMMARY="Google's Brotli C decoder (1.0.3 to 1.2.0) has an out-of-bounds write, first fixed in Node.js (Node2Shell) and now called HTTP2Shell because the same library ships in Python, Bun, curl and more. The PyPI Brotli package bundles that decoder. Reached by decompressing attacker-controlled data: Brotli responses that urllib3/requests, aiohttp, httpx or Scrapy decode automatically when Brotli is installed (webhooks, link previews, crawlers, any fetch of an untrusted URL), Brotli request bodies an aiohttp server inflates, or direct brotli.decompress() calls. As of 2026-10-24: no confirmed in-the-wild exploitation, not in CISA KEV; memory corruption in Python confirmed with AddressSanitizer."

# Every PyPI release before 1.2.1 bundles an affected (or older, also vulnerable) decoder.
AFFECTED="<1.2.1"
FIXED="1.2.1"
FIX_MIN_PYTHON=""
BACKPORTS=""

# OS-packaged copies (Debian/Ubuntu python3-brotli, Fedora python3-brotli) count as
# fixed when the package changelog lists these CVEs. Debian 12/13 fixed the brotli
# source package (1.0.9-2+deb12u1, 1.1.0-2+deb13u1); Ubuntu: under evaluation.
BACKPORT_CVES="CVE-2026-111497"

# Packages that decode Brotli automatically once this package is installed
RISK_PACKAGES="urllib3:urllib3 (requests, pip, botocore) advertises and decodes Brotli responses automatically when Brotli is installed: any fetch of an attacker-controlled URL reaches the decoder|aiohttp:aiohttp decodes Brotli responses on clients and Brotli request bodies on servers|httpx:httpx decodes Brotli responses when Brotli is installed|scrapy:Scrapy decodes Brotli responses from the sites it crawls"

# Declaring these extras installs this package even when it is not listed directly
PULLED_BY="urllib3[brotli]|httpx[brotli]|aiohttp[speedups]"

CODE_HINTS="brotli\.decompress\(|brotli\.Decompressor\( => direct Brotli decompression (untrusted input reaches the decoder)"

MITIGATIONS="Until upgraded: where Brotli is optional, uninstall Brotli and brotlicffi and drop extras like urllib3[brotli], httpx[brotli] and aiohttp[speedups] (urllib3/httpx then stop asking for Brotli and cannot decode it); block Content-Encoding: br request bodies at the proxy for aiohttp servers; run services that fetch untrusted URLs as unprivileged users with no secrets in their environment and restricted outbound network. Do not just strip br from Accept-Encoding: a malicious server can still send Brotli."

IDS="CVE-2026-111497 (HTTP2Shell / Node2Shell / Python2Shell)"

RELOCK="uv lock --upgrade-package brotli | poetry update brotli | pip-compile --upgrade-package brotli | pdm update brotli"

SOURCES="https://pypi.org/project/Brotli/1.2.1/ | https://github.com/google/brotli/releases | https://security-tracker.debian.org/tracker/CVE-2026-111497 | https://ubuntu.com/security/CVE-2026-111497 | https://strobes.co/blog/http2shell-brotli-rce-cve-2026-111497/"
LAST_VERIFIED="2026-10-24"
